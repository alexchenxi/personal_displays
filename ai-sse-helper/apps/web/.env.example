# OpenAI 兼容 API 地址
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
# Moonshot: https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# API Key
OPENAI_API_KEY=your-api-key-here

# 模型名称
# 通义千问: qwen3.6-plus / qwen3.6-max-preview / qwen3.6-flash
# DeepSeek: deepseek-chat
# Moonshot: moonshot-v1-8k
OPENAI_MODEL=qwen3.6

#################################
#  STRIPE
#################################
# Secret key (server-side)
STRIPE_SECRET_KEY=
# API version
STRIPE_API_VERSION=2025-03-31.basil
# Publishable key (client-side, NEXT_PUBLIC_ required by Next.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe customer email used for preorder demo
STRIPE_CUSTOMER_EMAIL=
# Payment method configuration ID
STRIPE_PAYMENT_METHOD_CONFIGURATION=
# Test customer ID
NEXT_PUBLIC_TEST_CUSTOMER_ID=cus_UXRhkAr9B7FNqh
# Domain
NEXT_PUBLIC_DOMAIN=http://localhost:3000

#################################
#  PREORDER DEMO
#################################
PREORDER_INVOICE_CURRENCY=usd
PREORDER_INVOICE_AMOUNT=2000
PREORDER_INVOICE_TAX_BEHAVIOR=inclusive